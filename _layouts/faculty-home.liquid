---
layout: default
---
{% assign is_zh = false %}
{% assign research_path = '/research/' %}
{% assign publications_path = '/publications/' %}
{% assign news_path = '/news/' %}
{% assign activities_path = '/activities/' %}
{% if page.lang contains 'zh' %}
  {% assign is_zh = true %}
  {% assign research_path = '/zh/research/' %}
  {% assign publications_path = '/zh/publications/' %}
  {% assign news_path = '/zh/news/' %}
  {% assign activities_path = '/zh/activities/' %}
{% endif %}
{% assign profile = site.data.profile %}
{% assign cv_path = profile.cv_en | default: profile.cv %}
{% if is_zh %}{% assign cv_path = profile.cv_zh | default: profile.cv %}{% endif %}
<div class="faculty-home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        {% if is_zh %}无线系统 × 人工智能{% else %}Wireless Systems × Artificial Intelligence{% endif %}
      </div>
      <h1 id="home-title">
        {% if is_zh -%}
          {{- profile.name_zh }}
          <span>| {{ profile.name_en }}</span>
        {%- else -%}
          {{- profile.name_en }}
          <span>| {{ profile.name_zh }}</span>
        {%- endif %}
      </h1>
      <div class="hero-role">
        {% if is_zh %}
          {{ profile.role_zh }} · {{ profile.school_zh -}}
          <br>
          {{ profile.university_zh }}
        {% else %}
          {{ profile.role_en }} · {{ profile.school_en -}}
          <br>
          <a href="https://www.bupt.edu.cn/" target="_blank" rel="noopener noreferrer">{{ profile.university_en }}</a>
        {% endif %}
      </div>
      <div class="hero-summary">
        {% if is_zh %}{{ profile.summary_zh }}{% else %}{{ profile.summary_en }}{% endif %}
      </div>
      <div class="hero-links" aria-label="{% if is_zh %}联系方式与学术主页{% else %}Contact and academic profiles{% endif %}">
        <span class="hero-email-links"
          ><i class="fa-regular fa-envelope" aria-hidden="true"></i><span>{{ profile.email_bupt }}</span></span
        >
        <span class="hero-profile-links">
          <a href="{{ profile.scholar }}" target="_blank" rel="noopener noreferrer"
            ><i class="ai ai-google-scholar" aria-hidden="true"></i> Scholar</a
          >
          <a href="{{ profile.orcid }}" target="_blank" rel="noopener noreferrer"><i class="ai ai-orcid" aria-hidden="true"></i> ORCID</a>
          <a href="{{ cv_path | relative_url }}" target="_blank" rel="noopener noreferrer"
            ><i class="fa-regular fa-file-pdf" aria-hidden="true"></i> CV</a
          >
        </span>
      </div>
    </div>
    <div class="hero-portrait">
      <div class="portrait-frame">
        <picture>
          <source media="(max-width: 575px)" srcset="{{ profile.portrait_small | prepend: '/assets/img/' | relative_url }}">
          <img
            src="{{ profile.portrait | prepend: '/assets/img/' | relative_url }}"
            alt="{% if is_zh %}迟国轩的学术肖像{% else %}Portrait of Guoxuan Chi{% endif %}"
            width="960"
            height="1200"
            loading="eager"
          >
        </picture>
      </div>
      <dl class="portrait-contact">
        <div>
          <dt>
            {% if is_zh %}办公室{% else %}Office{% endif %}
          </dt>
          <dd>
            {% if is_zh %}{{ profile.office_zh }}{% else %}{{ profile.office_en }}{% endif %}
          </dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="home-section home-news" aria-labelledby="news-heading">
    <div class="section-heading">
      <h2 id="news-heading">
        {% if is_zh %}近期动态{% else %}Recent news{% endif %}
      </h2>
      <a class="section-link" href="{{ news_path | relative_url }}">
        {%- if is_zh %}全部动态{% else %}All news{% endif -%}
      </a>
    </div>
    <ol class="news-list home-news-list">
      {% assign home_news = site.data.news | where: 'home', true | sort: 'date' | reverse %}
      {% for item in home_news limit: 4 %}
        <li>
          <time datetime="{{ item.date }}">
            {%- if is_zh %}{{ item.date | date: '%Y.%m' }}{% else %}{{ item.date | date: '%b %Y' }}{% endif -%}
          </time>
          <span>
            {% if is_zh %}{{ item.zh }}{% else %}{{ item.en }}{% endif %}
            {% if item.conference_id %}
              <a class="news-detail-link" href="{{ activities_path | relative_url }}#conference-{{ item.conference_id }}">
                {%- if is_zh %}照片与详情{% else %}Photos & details{% endif -%}
              </a>
            {% elsif item.url and item.type != 'award' %}
              <a class="news-detail-link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
                {%- if is_zh %}详情{% else %}Details{% endif -%}
              </a>
            {% endif %}
          </span>
        </li>
      {% endfor %}
    </ol>
  </section>
  <section class="home-section research-overview" aria-labelledby="research-heading">
    <div class="section-heading">
      <h2 id="research-heading">
        {% if is_zh %}研究方向{% else %}Research areas{% endif %}
      </h2>
      <a class="section-link" href="{{ research_path | relative_url }}">
        {%- if is_zh %}研究详情{% else %}Research details{% endif -%}
      </a>
    </div>
    <div class="research-grid">
      {% for area in site.data.research %}
        <article class="research-pillar">
          {% if area.image %}
            <figure class="pillar-media">
              <img
                src="{{ area.image | relative_url }}"
                alt="{% if is_zh %}{{ area.image_alt_zh }}{% else %}{{ area.image_alt_en }}{% endif %}"
                width="960"
                height="600"
                loading="lazy"
              >
            </figure>
          {% endif %}
          <h3>
            <a href="{{ research_path | relative_url }}#{{ area.id }}">
              {%- if is_zh %}{{ area.title_zh }}{% else %}{{ area.title_en }}{% endif -%}
            </a>
          </h3>
          <p>
            {% if is_zh %}{{ area.tagline_zh }}{% else %}{{ area.tagline_en }}{% endif %}
          </p>
          <div class="pillar-work">
            {% if is_zh %}{{ area.representative_zh }}{% else %}{{ area.representative_en }}{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
  <section class="home-section selected-work" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">
        {% if is_zh %}代表性论文{% else %}Selected publications{% endif %}
      </h2>
      <a class="section-link" href="{{ publications_path | relative_url }}">
        {%- if is_zh %}全部论文{% else %}All publications{% endif -%}
      </a>
    </div>
    <div class="featured-publications">
      {% for publication in site.data.featured_publications %}
        <article class="featured-publication">
          {% if publication.image %}
            <a class="featured-publication-media" href="{{ publication.html }}" target="_blank" rel="noopener noreferrer">
              <img
                src="{{ publication.image | relative_url }}"
                alt="{% if is_zh %}{{ publication.image_alt_zh }}{% else %}{{ publication.image_alt_en }}{% endif %}"
                width="960"
                height="600"
                loading="lazy"
              >
            </a>
          {% endif %}
          <div class="publication-main">
            <div class="publication-meta">
              <span>{{ publication.venue }}</span><span>{{ publication.year }}</span>
              {% if publication.authorship_en -%}
                <span class="publication-authorship">
                  {%- if is_zh %}{{ publication.authorship_zh }}{% else %}{{ publication.authorship_en }}{% endif -%}
                </span>
              {%- endif %}
              {% if publication.award -%}
                <span class="publication-award">{{ publication.award }}</span>
              {%- endif %}
            </div>
            <h3>{{ publication.title }}</h3>
            <p>
              {% if is_zh %}{{ publication.tldr_zh }}{% else %}{{ publication.tldr_en }}{% endif %}
            </p>
            <div class="publication-actions">
              {% if publication.html -%}
                <a href="{{ publication.html }}" target="_blank" rel="noopener noreferrer">
                  {%- if is_zh %}论文主页{% else %}Paper{% endif -%}
                </a>
              {%- endif %}
              {% if publication.paper -%}
                <a href="{{ publication.paper | relative_url }}" target="_blank" rel="noopener noreferrer">PDF</a>
              {%- endif %}
              {% if publication.code -%}
                <a href="{{ publication.code }}" target="_blank" rel="noopener noreferrer">
                  {%- if is_zh %}代码{% else %}Code{% endif -%}
                </a>
              {%- endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
</div>
