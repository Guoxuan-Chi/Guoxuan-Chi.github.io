---
layout: default
---
<div class="faculty-page">
  <header class="faculty-page-header">
    {% if page.kicker %}<div class="section-kicker">{{ page.kicker }}</div>{% endif %}
    <h1>{{ page.title }}</h1>
    {% if page.description %}<p>{{ page.description }}</p>{% endif %}
  </header>
  <article class="faculty-page-content">
    {{ content }}
  </article>
</div>

