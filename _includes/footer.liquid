{% assign footer_zh = false %}
{% if page.lang contains 'zh' %}
  {% assign footer_zh = true %}
{% endif %}

<footer class="faculty-footer" role="contentinfo">
  <div class="container">
    <div class="footer-secondary">
      <span>
        © {{ site.time | date: '%Y' }} Guoxuan Chi ·
        {% if footer_zh %}北京邮电大学{% else %}Beijing University of Posts and Telecommunications{% endif %}
      </span>
      <span>
        {% if footer_zh %}最后更新：{{ site.time | date: '%Y年%m月' }}{% else %}Last updated: {{ site.time | date: '%B %Y' }}{% endif %}
      </span>
    </div>
  </div>
</footer>
