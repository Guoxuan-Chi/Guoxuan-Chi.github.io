{% assign is_zh = false %}
{% if page.lang contains 'zh' %}{% assign is_zh = true %}{% endif %}
<section class="activity-funding">
  <div class="section-kicker">
    {% if is_zh %}科研资助{% else %}Funding{% endif %}
  </div>
  <h2>
    {% if is_zh %}主持科研项目{% else %}Research grants{% endif %}
  </h2>
  <div class="funding-list">
    {% for item in site.data.activities.funding %}
      <article class="funding-record">
        <div class="funding-role">
          {% if is_zh %}{{ item.role_zh }}{% else %}{{ item.role_en }}{% endif %}
        </div>
        <h3>
          {% if is_zh %}{{ item.title_zh }}{% else %}{{ item.title_en }}{% endif %}
        </h3>
      </article>
    {% endfor %}
  </div>
</section>
{% assign exchanges = site.data.activities.conferences | concat: site.data.talks | sort: 'date' | reverse %}
{% if exchanges and exchanges.size > 0 %}
  <section class="activity-talks" id="academic-exchange" aria-labelledby="academic-exchange-heading">
    <span class="activity-anchor" id="conference-chairing" aria-hidden="true"></span>
    <span class="activity-anchor" id="invited-talks" aria-hidden="true"></span>
    <div class="section-kicker">
      {% if is_zh %}学术交流{% else %}Academic exchange{% endif %}
    </div>
    <h2 id="academic-exchange-heading">
      {% if is_zh %}会议主持与邀请报告{% else %}Conference chairing & invited talks{% endif %}
    </h2>
    <div class="resource-directory">
      {% for exchange in exchanges %}
        {% assign has_images = false %}
        {% if exchange.images and exchange.images.size > 0 %}{% assign has_images = true %}{% endif %}
        <article
          id="{% if exchange.role_en %}conference-{% else %}talk-{% endif %}{{ exchange.id }}"
          class="resource-entry academic-exchange-entry{% unless has_images %} resource-entry--text{% endunless %}"
        >
          <div class="resource-entry-meta">
            <time datetime="{{ exchange.date }}">
              {%- if is_zh -%}
                {{- exchange.date | date: '%Y.%m.%d' -}}
                {%- if exchange.date_end %}–{{ exchange.date_end | date: '%d' }}{% endif -%}
              {%- else -%}
                {{- exchange.date | date: '%b %-d' -}}
                {%- if exchange.date_end %}–{{ exchange.date_end | date: '%-d' }}{% endif -%}
                , {{ exchange.date | date: '%Y' }}
              {%- endif -%}
            </time>
            <span>
              {%- if is_zh %}{{ exchange.role_zh | default: '邀请报告' }}{% else %}{{ exchange.role_en | default: 'Invited talk' }}{% endif -%}
            </span>
          </div>
          <div class="resource-entry-body">
            <h3>
              {% if is_zh %}{{ exchange.title_zh }}{% else %}{{ exchange.title_en }}{% endif %}
            </h3>
            <p>
              <strong>
                {%- if is_zh %}{{ exchange.event_zh }}{% else %}{{ exchange.event_en }}{% endif -%}
              </strong>
              {% if exchange.location_en -%}
                · {% if is_zh %}{{ exchange.location_zh }}{% else %}{{ exchange.location_en }}{% endif -%}
              {%- endif %}
            </p>
            <p>
              {% if is_zh %}{{ exchange.description_zh }}{% else %}{{ exchange.description_en }}{% endif %}
            </p>
            {% if exchange.event_url or exchange.paper_url or exchange.slides_url %}
              <div class="resource-entry-links">
                {% if exchange.event_url %}
                  <a href="{{ exchange.event_url }}" target="_blank" rel="noopener noreferrer">
                    {% if is_zh %}活动页面{% else %}Event{% endif %}
                    <span aria-hidden="true">↗</span>
                  </a>
                {% endif %}
                {% if exchange.paper_url %}
                  <a href="{{ exchange.paper_url }}" target="_blank" rel="noopener noreferrer">
                    {% if is_zh %}论文{% else %}Paper{% endif %}
                    <span aria-hidden="true">↗</span>
                  </a>
                {% endif %}
                {% if exchange.slides_url %}
                  <a href="{{ exchange.slides_url | relative_url }}" target="_blank" rel="noopener noreferrer">
                    {% if is_zh %}幻灯片{% else %}Slides{% endif %}
                    <span aria-hidden="true">↗</span>
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
          {% if has_images %}
            <div class="activity-gallery{% if exchange.images.size > 1 %} activity-gallery--multiple{% endif %}">
              {% for image in exchange.images %}
                {% assign image_src = image.src | default: image.path | default: image %}
                {% assign image_alt = image.alt_en | default: exchange.title_en %}
                {% if is_zh %}{% assign image_alt = image.alt_zh | default: exchange.title_zh %}{% endif %}
                <figure class="resource-entry-media">
                  <a
                    href="{{ image_src | relative_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="{% if is_zh %}查看原图：{% else %}View full photo: {% endif %}{{ image_alt | escape }}"
                  >
                    <img
                      src="{{ image_src | relative_url }}"
                      alt="{{ image_alt | escape }}"
                      width="{{ image.width | default: 960 }}"
                      height="{{ image.height | default: 600 }}"
                      loading="lazy"
                    >
                  </a>
                </figure>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
<div class="activities-grid">
  <section id="honors">
    <div class="section-kicker">
      {% if is_zh %}外部认可{% else %}Recognition{% endif %}
    </div>
    <h2>
      {% if is_zh %}荣誉与奖励{% else %}Honors & awards{% endif %}
    </h2>
    <ol class="timeline-list">
      {% for item in site.data.activities.honors %}
        <li>
          <time>{{ item.year }}</time
          ><span>
            {%- if is_zh %}{{ item.title_zh }}{% else %}{{ item.title_en }}{% endif -%}
            {% if item.project_en %}
              <small class="honor-project">
                {%- if is_zh %}{{ item.project_zh }}{% else %}{{ item.project_en }}{% endif -%}
              </small>
            {% endif %}
          </span>
        </li>
      {% endfor %}
    </ol>
  </section>
  <section>
    <div class="section-kicker">
      {% if is_zh %}学术共同体{% else %}Community{% endif %}
    </div>
    <h2>
      {% if is_zh %}学术服务{% else %}Academic service{% endif %}
    </h2>
    <div class="service-groups">
      {% for group in site.data.activities.service %}
        <div class="service-group">
          <h3>
            {% if is_zh %}{{ group.group_zh }}{% else %}{{ group.group_en }}{% endif %}
          </h3>
          <ul>
            {% for item in group.items %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </section>
</div>
