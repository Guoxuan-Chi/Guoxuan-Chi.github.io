{% assign is_zh = false %}
{% if page.lang contains 'zh' %}{% assign is_zh = true %}{% endif %}
<div class="resource-directory">
  {% for resource in site.data.resources %}
    <section class="resource-entry">
      <div class="resource-entry-meta">
        <span>0{{ forloop.index }}</span>
        <span>{% if is_zh %}{{ resource.type_zh }}{% else %}{{ resource.type_en }}{% endif %}</span>
      </div>
      <div class="resource-entry-body">
        <h2>{{ resource.name }}</h2>
        <p>{% if is_zh %}{{ resource.description_zh }}{% else %}{{ resource.description_en }}{% endif %}</p>
        <div class="resource-entry-links">
          {% for link in resource.links %}
            <a href="{{ link.url | relative_url }}" target="_blank" rel="noopener noreferrer">
              {% if is_zh %}{{ link.label_zh }}{% else %}{{ link.label }}{% endif %} <span aria-hidden="true">↗</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endfor %}
</div>
<aside class="resource-note">
  {% if is_zh %}
    <strong>开放研究说明</strong>
    <p>本页优先收录可复用的代码、数据、教程与系统材料。新的开放资源将在稳定后持续补充。</p>
  {% else %}
    <strong>About open research</strong>
    <p>This page prioritizes reusable code, data, tutorials, and system artifacts. New resources will be added once they are ready for public use.</p>
  {% endif %}
</aside>

