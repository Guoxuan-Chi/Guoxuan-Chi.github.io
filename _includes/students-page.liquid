{% assign is_zh = false %}
{% assign research_path = '/research/' %}
{% if page.lang contains 'zh' %}
  {% assign is_zh = true %}
  {% assign research_path = '/zh/research/' %}
{% endif %}
<div class="collaboration-layout">
  <section class="collaboration-areas" aria-labelledby="collaboration-areas-heading">
    <p class="collaboration-intro">
      {% if is_zh %}欢迎围绕以下方向开展科研交流与合作。{% else %}I welcome research discussions and collaboration in the following areas.{% endif %}
    </p>
    <h2 id="collaboration-areas-heading">
      {% if is_zh %}研究方向{% else %}Research areas{% endif %}
    </h2>
    <ul>
      {% for area in site.data.research %}
        <li>
          <a href="{{ research_path | relative_url }}#{{ area.id }}">
            {%- if is_zh %}{{ area.title_zh }}{% else %}{{ area.title_en }}{% endif -%}
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>
  <aside class="contact-panel" aria-labelledby="contact-heading">
    <h2 id="contact-heading">
      {% if is_zh %}联系方式{% else %}Contact{% endif %}
    </h2>
    <p class="contact-email">{{ site.data.profile.email_bupt }}</p>
    <p>
      {% if is_zh %}
        {{ site.data.profile.university_zh }} · {{ site.data.profile.school_zh -}}
        <br>
        {{ site.data.profile.office_zh }}
      {% else %}
        {{ site.data.profile.school_en -}}
        <br>
        {{ site.data.profile.university_en -}}
        <br>
        {{ site.data.profile.office_en }}
      {% endif %}
    </p>
  </aside>
</div>
