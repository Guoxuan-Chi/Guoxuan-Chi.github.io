{% assign is_zh = false %}
{% assign activities_path = '/activities/' %}
{% if page.lang contains 'zh' %}
  {% assign is_zh = true %}
  {% assign activities_path = '/zh/activities/' %}
{% endif %}
{% assign news_items = site.data.news | sort: 'date' | reverse %}
{% assign news_years = news_items | group_by_exp: 'item', "item.date | date: '%Y'" %}
{% for year in news_years %}
  <section class="news-year" aria-labelledby="news-year-{{ year.name }}">
    <h2 id="news-year-{{ year.name }}">{{ year.name }}</h2>
    <ol class="news-archive">
      {% for item in year.items %}
        <li>
          <div class="news-item-meta">
            <time datetime="{{ item.date }}">
              {%- if is_zh -%}
                {{- item.date | date: '%m.%d' -}}
                {%- if item.date_end %}–{{ item.date_end | date: '%m.%d' }}{% endif -%}
              {%- else -%}
                {{- item.date | date: '%b %-d' -}}
                {%- if item.date_end %}–{{ item.date_end | date: '%-d' }}{% endif -%}
              {%- endif -%}
            </time>
            <span class="news-type">
              {% case item.type %}
                {% when 'service' -%}
                  {%- if is_zh %}学术服务{% else %}Service{% endif %}
                {% when 'award' -%}
                  {%- if is_zh %}获奖{% else %}Award{% endif %}
                {% when 'publication' -%}
                  {%- if is_zh %}论文发表{% else %}Publication{% endif %}
                {% when 'talk' -%}
                  {%- if is_zh %}报告{% else %}Talk{% endif %}
                {% else -%}
                  {%- if is_zh %}动态{% else %}Update{% endif %}
              {% endcase %}
            </span>
          </div>
          <p>
            {% if is_zh %}{{ item.zh }}{% else %}{{ item.en }}{% endif %}
            {% if item.conference_id %}
              <a class="news-detail-link" href="{{ activities_path | relative_url }}#conference-{{ item.conference_id }}">
                {%- if is_zh %}照片与详情{% else %}Photos & details{% endif -%}
              </a>
            {% elsif item.url and item.type != 'award' %}
              <a class="news-detail-link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
                {%- if is_zh %}详情{% else %}Details{% endif -%}
              </a>
            {% endif %}
          </p>
        </li>
      {% endfor %}
    </ol>
  </section>
{% endfor %}
